# NapCat OneBot 11 forward WebSocket
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# AIRI event hub. Used for module configuration/status and as the fallback
# generation path when QQ_LLM_* is not configured.
AIRI_TOKEN=abcd
AIRI_URL=ws://127.0.0.1:6121/ws

# Optional headless QQ generation. Configure all three values to let QQ keep
# replying after the browser is closed. This uses one non-streaming LLM call.
QQ_LLM_BASE_URL=https://api.openai.com/v1/
QQ_LLM_API_KEY=
QQ_LLM_MODEL=
QQ_LLM_SYSTEM_PROMPT_FILE=./character/mita.txt

# Persistent recent conversation history. Session keys include the QQ bot
# account, then the private user or group, so multiple NapCat accounts do not
# share chat context.
QQ_LLM_MEMORY_FILE=./data/qq-memory.json
QQ_LLM_MAX_HISTORY_MESSAGES=40
# Optional short prompt override. The file takes precedence when both are set.
QQ_LLM_SYSTEM_PROMPT=
